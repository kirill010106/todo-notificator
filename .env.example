# Пример .env файла для toDoNotificator

# Database connection string (PostgreSQL URL format)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo?sslmode=disable

# Path to config file
CONFIG_PATH=./config/local.yaml

# Application secret for JWT signing (CHANGE THIS IN PRODUCTION!)
APP_SECRET=change-this-to-a-random-secret-in-production-min-32-chars

# YooKassa payment integration (optional)
# SHOP_ID=your_shop_id
# SECRET_KEY=your_secret_key

# Webhook secret for communication with email-notifier (optional for local)
# WEBHOOK_SECRET=your-webhook-secret

# SMTP (Brevo or custom)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_login_email_or_id
SMTP_PASSWORD=xsmtpsib-your-generated-smtp-key
SMTP_FROM=your_verified_sender_email@example.com
SMTP_SENDER_NAME=ToDoNotificator
