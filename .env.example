# One .env in the repository root. Process variables take precedence.
# Relative YAML paths resolve from the repository / selected ENV_FILE directory.
CONFIG_PATH=backend/config/local.yaml
EMAIL_CONFIG_PATH=notifiers/email/config/local.yaml

# dev.ps1 prepares these local databases without overriding these values.
# For external databases use ./dev.ps1 -SkipDatabases.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/todo?sslmode=disable
MONGO_URL=mongodb://127.0.0.1:27017
CLIENT_URL=http://localhost:3030
APP_URL=http://localhost:3030
WEBHOOK_URL=http://localhost:8084
ACTIVITY_LOGGER_ADDR=localhost:50051
APP_SECRET=change-this-to-a-random-secret-in-production-min-32-chars
WEBHOOK_SECRET=change-this-to-another-random-shared-secret

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_login_email_or_id
SMTP_PASSWORD=xsmtpsib-your-generated-smtp-key
SMTP_FROM=your_verified_sender_email@example.com
SMTP_SENDER_NAME=ToDoNotificator

# Optional: configure both values to enable YooKassa.
SHOP_ID=
SECRET_KEY=
# Optional Telegram prototype, not started by dev.ps1 or Compose.
BOT_TOKEN=
# Public frontend setting; never put secrets in VITE_*.
VITE_API_BASE_URL=/api/v1

# Production uses a separate checkout with its own root .env.
# Use .env.production.example and docs/DEPLOYMENT.md for IMAGE_BASE,
# IMAGE_TAG, TRUSTED_PROXIES and container addresses.
