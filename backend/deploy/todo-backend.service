# Systemd unit for ToDo Notificator — backend
#
# Установка на сервере (один раз):
#   sudo cp backend/deploy/todo-backend.service /etc/systemd/system/backend.service
#   sudo nano /home/ubuntu/todo-notificator/.env                                 # заполни секреты
#   sudo systemctl daemon-reload
#   sudo systemctl enable backend
#   sudo systemctl start backend

[Unit]
Description=ToDo Notificator — Backend API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/todo-notificator

# Переменные окружения: чувствительные значения хранятся отдельно от конфига
EnvironmentFile=/home/ubuntu/todo-notificator/.env
Environment=CONFIG_PATH=/home/ubuntu/todo-notificator/backend/config/prod.yaml

ExecStart=/home/ubuntu/todo-notificator/backend

# Автоматический перезапуск при падении (но не при exit 0/SIGTERM)
Restart=on-failure
RestartSec=5s

# Ограничения безопасности
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/todo-notificator

StandardOutput=journal
StandardError=journal
SyslogIdentifier=todo-backend

[Install]
WantedBy=multi-user.target
