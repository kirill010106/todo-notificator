# Шаблон /opt/todo-notificator/.env
# Скопировать на сервер: sudo nano /opt/todo-notificator/.env
# Права: sudo chmod 600 /opt/todo-notificator/.env
#        sudo chown todo:todo /opt/todo-notificator/.env

ENV=prod
CONFIG_PATH=/opt/todo-notificator/config/prod.yaml

# PostgreSQL DSN
STORAGE_PATH=postgres://todo_user:changeme@localhost:5432/todo_db?sslmode=disable

# JWT — минимум 32 случайных символа: openssl rand -hex 32
APP_SECRET=changeme

# Webhook для email-нотификатора (если запущен на том же хосте)
# Порт 8086 выбран т.к. 8081 занят другим сервисом
WEBHOOK_URL=http://localhost:8086
WEBHOOK_SECRET=changeme
