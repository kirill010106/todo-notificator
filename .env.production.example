# Copy to .env ONLY in a dedicated production checkout. Do not overwrite local settings.
# All four images must already be published for this exact commit.
IMAGE_BASE=ghcr.io/kirill010106/todo-notificator
IMAGE_TAG=REPLACE_WITH_40_CHARACTER_COMMIT_SHA

# Runtime inside production containers. Compose also enforces these values.
ENV=prod
AUTO_MIGRATE=false
CONFIG_PATH=/app/config/prod.yaml
EMAIL_CONFIG_PATH=/app/config/prod.yaml

# PostgreSQL on the same server, managed automatically by the release script.
# Generate a URL-safe password: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=todo
POSTGRES_DB=todo
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD_AT_LEAST_32_CHARACTERS
# DATABASE_URL is derived by Compose; do not copy the local development DSN here.
# Optional external DB override (then the bundled PostgreSQL is not started):
# DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional: deploy_release.py discovers Traefik on its Docker network automatically.
# You can omit this line; explicit IPs/CIDRs remain supported for custom setups.
TRUSTED_PROXIES=auto
CLIENT_URL=https://todo.chkpnk.ru
APP_URL=https://todo.chkpnk.ru
WEBHOOK_URL=http://email-notifier:8084
ACTIVITY_LOGGER_ADDR=activity-logger:50051
MONGO_URL=mongodb://mongo:27017
# Public build-time setting for local npm builds; published images must be rebuilt
# with the matching VITE_API_BASE_URL build argument when this URL changes.
VITE_API_BASE_URL=https://todoapi.chkpnk.ru/api/v1

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SMTP_FROM=noreply@chkpnk.ru
SMTP_SENDER_NAME=ToDoNotificator

# Optional: leave BOTH empty to disable payments.
SHOP_ID=
SECRET_KEY=
# pg_dump version must be at least the PostgreSQL server version.
POSTGRES_TOOLS_IMAGE=postgres:16-alpine
