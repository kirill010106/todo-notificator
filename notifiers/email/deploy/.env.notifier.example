# Шаблон /opt/todo-notificator/.env.notifier
# Скопировать на сервер: sudo nano /opt/todo-notificator/.env.notifier
# Права: sudo chmod 600 /opt/todo-notificator/.env.notifier
#        sudo chown todo:todo /opt/todo-notificator/.env.notifier

EMAIL_CONFIG_PATH=/opt/todo-notificator/config/email-prod.yaml

# PostgreSQL — тот же инстанс, что и у бэкенда
DATABASE_URL=postgres://todo_user:changeme@localhost:5432/todo_db?sslmode=disable

# SMTP (например smtp.mail.ru / smtp.gmail.com)
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=changeme

# Должен совпадать с WEBHOOK_SECRET бэкенда
WEBHOOK_SECRET=changeme
